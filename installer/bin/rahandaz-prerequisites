#!/usr/bin/env bash
# Rahandaz prerequisite contract v1. Local operator entry point, not a panel action.
set -Eeuo pipefail
export LC_ALL=C LANG=C
umask 077
# The live entry point always inspects the real OS and PID 1, not fixture overrides.
INSTALLER_OS_RELEASE=/etc/os-release
INSTALLER_PROC_ROOT=/proc
unset INSTALLER_LOG INSTALLER_STATE_FILE
INSTALLER_HOME="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
source "${INSTALLER_HOME}/lib/common.sh"
source "${INSTALLER_HOME}/lib/os.sh"
source "${INSTALLER_HOME}/lib/gate.sh"
source "${INSTALLER_HOME}/lib/php-runtime.sh"
source "${INSTALLER_HOME}/lib/prerequisites.sh"

prereq_main "$@"
