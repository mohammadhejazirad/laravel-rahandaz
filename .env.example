APP_NAME=Rahandaz
APP_ENV=local
APP_KEY=
APP_DEBUG=true
# Origin only. The panel prefix lives in RAHANDAZ_BASE_PATH.
# PROJECT_SPEC.md shows APP_URL with /rahandaz included; combining both would double the prefix.
APP_URL=http://127.0.0.1:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Native PHP connects to the Compose services through 127.0.0.1.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=rahandaz
DB_USERNAME=rahandaz
DB_PASSWORD=replace-local-only

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/rahandaz
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
# Native PHP connects to the Compose services through 127.0.0.1.
REDIS_QUEUE_HOST=127.0.0.1
REDIS_QUEUE_PORT=6379
REDIS_QUEUE_DB=0
REDIS_CACHE_HOST=127.0.0.1
REDIS_CACHE_PORT=6380
REDIS_CACHE_DB=0

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

RAHANDAZ_EXECUTION_MODE=disabled
RAHANDAZ_ARCHIVE_MAX_UPLOAD_BYTES=104857600
RAHANDAZ_ARCHIVE_MAX_ENTRIES=20000
RAHANDAZ_ARCHIVE_MAX_ENTRY_BYTES=268435456
RAHANDAZ_ARCHIVE_MAX_UNCOMPRESSED_BYTES=1073741824
RAHANDAZ_ARCHIVE_MAX_COMPRESSION_RATIO=100
RAHANDAZ_BASE_PATH=/rahandaz
RAHANDAZ_DEFAULT_TIMEZONE=Asia/Tehran
# Spec path. Filesystems that ignore chmod must point these at a POSIX volume.
RAHANDAZ_MASTER_KEY_FILE=./var/config/master.key
RAHANDAZ_CANARY_FILE=./var/config/canary.json
RAHANDAZ_WORKER_TIMEOUT=60
REDIS_QUEUE_RETRY_AFTER=90
RAHANDAZ_UPDATE_CHANNEL=stable
RAHANDAZ_GITHUB_REPOSITORY=
RAHANDAZ_RELEASE_FILE=
